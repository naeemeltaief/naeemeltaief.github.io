# Public origin of the deployed site (no trailing slash). Used for canonical URLs, OG tags and the sitemap.
VITE_SITE_URL=https://naeemeltaief.me

# Optional: a form backend that accepts JSON POSTs (e.g. https://formspree.io/f/xxxxxxx).
# Leave empty and the contact form opens the visitor's email app with the message pre-filled.
VITE_FORM_ENDPOINT=
